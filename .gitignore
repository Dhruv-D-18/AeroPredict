# AeroPredict Git Ignore Rules

# Python-related ignores
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# Large datasets (data/ layout — small lookup / geolocation files stay tracked)
data/raw/US_flights_2023.csv
data/raw/Cancelled_Diverted_2023.csv
data/raw/weather_meteo_by_airport.csv
data/raw/maj us flight - january 2024.csv
data/processed/*.csv
data/processed/*.parquet
# Legacy locations (before the folder restructure)
flight_delay/*.csv
preprocessed_flight_data_final.csv

# Machine Learning model checkpoints and large exports (Keep small pkl metadata if needed)
# If you want to force users to train models before running, uncomment these:
# *.pkl

# Visualization cache (weather_vs_delay.csv/json are 14MB and 46MB respectively)
# They can be committed to allow offline dashboard rendering, but if you want a minimal repo:
# webapp/static/viz_data/weather_vs_delay.csv
# webapp/static/viz_data/weather_vs_delay.json

# Open-Meteo response cache (forecasts + archive downloads). Regenerated on demand;
# wx_calibration.json IS tracked - it is small and required for correct serving.
.wx_cache/

# IDE Settings and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
